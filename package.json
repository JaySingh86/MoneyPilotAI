{
  "name": "moneypilot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.13.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev:live": "node tooling/dev-live.mjs",
    "dev": "turbo run dev --parallel --filter=@mp/api --filter=@mp/worker --filter=@mp/web",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings=0 && pnpm lint:css",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && vitest run --config tooling/fitness/vitest.config.ts",
    "test:engine": "pnpm --filter @mp/engine test",
    "test:rls": "pnpm --filter @mp/db test:rls",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "storage:init": "pnpm --filter @mp/api storage:init",
    "live:smoke": "pnpm --filter @mp/api live:smoke",
    "db:migrate": "pnpm --filter @mp/db migrate",
    "db:seed": "pnpm --filter @mp/db seed",
    "db:bootstrap:supabase": "pnpm --filter @mp/db bootstrap:supabase",
    "test:supabase-compat": "pnpm --filter @mp/db test:supabase-compat",
    "contracts:gen": "pnpm --filter @mp/contracts gen",
    "e2e": "pnpm --filter @mp/web e2e",
    "ai:eval": "pnpm --filter @mp/ai eval",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:css": "stylelint \"packages/ui/**/*.css\" \"apps/web/**/*.css\" --max-warnings=0 --allow-empty-input"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.4.0",
    "stylelint": "^18.0.0",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^5.1.0"
  }
}
