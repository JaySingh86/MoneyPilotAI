{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowJs": false,
    "incremental": true,
    "types": ["node", "react", "react-dom"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "esModuleInterop": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-prodcheck/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-dbg/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", ".next-*"]
}
