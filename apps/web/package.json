{
  "name": "@mp/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Next.js web app. UI only; numbers come from the API (ARCHITECTURE §2).",
  "scripts": {
    "dev": "NEXT_PUBLIC_MP_MOCK=1 next dev --port 3100",
    "dev:cognito": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "next typegen && tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "e2e:docker": "node scripts/e2e-docker.mjs test",
    "e2e:update": "node scripts/e2e-docker.mjs update"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@mp/contracts": "workspace:^",
    "@mp/format": "workspace:^",
    "@mp/ui": "workspace:^",
    "@tanstack/react-query": "^5",
    "aws-amplify": "^6",
    "lucide-react": "^1.62.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@mp/engine": "workspace:^",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.1.0",
    "msw": "^2",
    "vitest": "^3"
  }
}
