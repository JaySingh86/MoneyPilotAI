{
  "name": "@mp/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, SQL migrations, RLS, withHouseholdTx, seed loader (WP-03).",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "migrate": "tsx src/cli/migrate.ts",
    "seed": "tsx src/cli/seed.ts",
    "bootstrap:supabase": "tsx src/cli/bootstrap-supabase.ts",
    "test:supabase-compat": "vitest run --config vitest.supabase.config.ts"
  },
  "dependencies": {
    "@mp/engine": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@mp/format": "workspace:^",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/pg": "^8.23.1",
    "pg-boss": "12.38.0",
    "testcontainers": "^12.2.1"
  }
}
