{
  "name": "@mp/email",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Gmail/Graph/forwarding adapters, MIME to text, prefilter, redaction, matcher. Core built in WP-19; providers in WP-21.",
  "exports": {
    ".": "./src/index.ts",
    "./providers": "./src/providers/index.ts",
    "./oauth": "./src/oauth/index.ts",
