{
  "name": "@mp/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Web components on design tokens (DESIGN_SPEC \u00a74). Built in WP-04 and WP-10.",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build --output-dir dist/storybook",
    "tokens:gen": "tsx src/tokens/cli.ts gen",
    "tokens:check": "tsx src/tokens/cli.ts check",
    "test:visual": "pnpm build-storybook && playwright test",
    "test:visual:update": "node scripts/visual-docker.mjs update",
    "test:visual:docker": "node scripts/visual-docker.mjs test"
  },
  "dependencies": {
    "@mp/format": "workspace:*",
    "lucide-react": "^1.62.0"
  },
  "peerDependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "^10.6.4",
    "@storybook/react-vite": "^10.6.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "^4.14.0",
    "http-server": "^14.1.1",
    "jsdom": "^26.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.6.4",
    "vite": "^7.0.0"
  }
}
