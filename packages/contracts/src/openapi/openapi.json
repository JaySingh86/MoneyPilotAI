{
  "openapi": "3.1.0",
  "info": {
    "title": "MoneyPilot API",
    "version": "1.0.0",
    "description": "Household planning API. Money is integer cents, dates are YYYY-MM-DD, errors are RFC 9457 problem+json with a `code` (BACKEND_PLAN §8.1). The API never moves money."
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } },
    "schemas": {
      "ProblemFieldInput": {
        "type": "object",
        "properties": {
          "in": {
            "type": "string",
            "enum": ["body", "querystring", "params", "headers"],
            "description": "Where the invalid value was sent"
          },
          "path": {
            "type": "string",
            "description": "Dot path inside that part, e.g. `schedule.dayOfMonth`; empty for the root"
          },
          "message": { "type": "string" }
        },
        "required": ["in", "path", "message"]
      },
      "ProblemInput": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "description": "URI reference identifying the problem type" },
          "title": { "type": "string" },
          "status": { "type": "integer", "minimum": 400, "maximum": 599 },
          "detail": { "type": "string" },
          "instance": { "description": "Request path, without the query string", "type": "string" },
          "code": {
            "type": "string",
            "enum": [
              "validation_failed",
              "unauthorized",
              "forbidden",
              "not_found",
              "conflict",
              "entitlement_required",
              "mfa_required",
              "rate_limited",
              "idempotency_key_reused",
              "precondition_required",
              "payload_too_large",
              "unsupported_media_type",
              "bad_request",
              "internal_error"
            ]
          },
          "requestId": { "type": "string" },
          "fields": {
            "description": "Per-field errors for validation_failed",
            "type": "array",
            "items": { "$ref": "#/components/schemas/ProblemFieldInput" }
          },
          "current": { "description": "The current resource, on a version conflict (If-Match)" }
        },
        "required": ["type", "title", "status", "code"],
        "description": "RFC 9457 problem details"
      },
      "MembershipInput": {
        "type": "object",
        "properties": {
          "householdId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "householdName": { "type": "string" },
          "colorRole": { "type": "string", "enum": ["partnerA", "partnerB"] },
          "isCreator": { "type": "boolean" },
          "joinedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": ["householdId", "householdName", "colorRole", "isCreator", "joinedAt"]
      },
      "MeInput": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "email": { "type": "string", "description": "Verified email from the sign-in provider" },
          "firstName": { "type": "string" },
          "lastName": { "type": ["string", "null"] },
          "timezone": { "type": "string" },
          "mfaEnabled": { "type": "boolean" },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "memberships": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/MembershipInput" },
            "description": "Active household memberships"
          }
        },
        "required": [
          "id",
          "email",
          "firstName",
          "lastName",
          "timezone",
          "mfaEnabled",
          "createdAt",
          "memberships"
        ]
      },
      "BootstrapBodyInput": {
        "type": "object",
        "properties": {
          "firstName": { "type": "string", "minLength": 1, "maxLength": 80 },
          "lastName": {
            "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 80 }, { "type": "null" }]
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "IANA time zone name"
          }
        },
        "additionalProperties": false
      },
      "PatchMeBodyInput": {
        "type": "object",
        "properties": {
          "firstName": { "type": "string", "minLength": 1, "maxLength": 80 },
          "lastName": {
            "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 80 }, { "type": "null" }]
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "IANA time zone name"
          }
        },
        "additionalProperties": false
      },
      "HouseholdInput": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": { "type": "string" },
          "timezone": { "type": "string" },
          "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
          "cushionCents": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Integer cents"
          },
          "primaryIncomeItemId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              { "type": "null" }
            ]
          },
          "plan": { "type": "string", "enum": ["free", "family_plus"] },
          "forwardingToken": {
            "type": "string",
            "description": "Local part of the household's forwarding address"
          },
          "deletionScheduledFor": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              { "type": "null" }
            ]
          },
          "version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "name",
          "timezone",
          "currency",
          "cushionCents",
          "primaryIncomeItemId",
          "plan",
          "forwardingToken",
          "deletionScheduledFor",
          "version",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateHouseholdBodyInput": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "timezone": {
            "description": "Defaults to the signed-in user's time zone",
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "cushionCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Integer cents"
          }
        },
        "required": ["name"],
        "additionalProperties": false
      },
      "PatchHouseholdBodyInput": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "IANA time zone name"
          },
          "cushionCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Integer cents"
          }
        },
        "additionalProperties": false
      },
      "HouseholdMemberInput": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "firstName": { "type": "string" },
          "lastName": { "type": ["string", "null"] },
          "colorRole": { "type": "string", "enum": ["partnerA", "partnerB"] },
          "isCreator": { "type": "boolean" },
          "joinedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": ["userId", "firstName", "lastName", "colorRole", "isCreator", "joinedAt"]
      },
      "InviteInput": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "email": { "type": "string" },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": ["id", "email", "expiresAt", "createdAt"]
      },
      "CreateInviteBodyInput": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          }
        },
        "required": ["email"],
        "additionalProperties": false
      },
      "AcceptInviteBodyInput": {
        "type": "object",
        "properties": { "token": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" } },
        "required": ["token"],
        "additionalProperties": false
      },
      "AcceptInviteResponseInput": {
        "type": "object",
        "properties": {
          "householdId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": ["householdId"]
      },
      "HouseholdSummaryInput": {
        "type": "object",
        "properties": {
          "household": { "$ref": "#/components/schemas/HouseholdInput" },
          "members": { "type": "array", "items": { "$ref": "#/components/schemas/HouseholdMemberInput" } },
          "openInvite": { "anyOf": [{ "$ref": "#/components/schemas/InviteInput" }, { "type": "null" }] },
          "badges": {
            "type": "object",
            "properties": {
              "reviewQueue": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "tasksDue": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "proposalsPending": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
            },
            "required": ["reviewQueue", "tasksDue", "proposalsPending"]
          },
          "entitlements": {
            "type": "object",
            "properties": {
              "plan": { "type": "string", "enum": ["free", "family_plus"] },
              "maxAdults": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
            },
            "required": ["plan", "maxAdults"]
          },
          "connections": {
            "type": "object",
            "properties": {
              "emailConnections": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
            },
            "required": ["emailConnections"]
          }
        },
        "required": ["household", "members", "openInvite", "badges", "entitlements", "connections"]
      },
