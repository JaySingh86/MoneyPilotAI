{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "passThroughEnv": [
        "DOCKER_HOST",
        "TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE",
        "TESTCONTAINERS_HOST_OVERRIDE",
        "TESTCONTAINERS_RYUK_DISABLED"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
