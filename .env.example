# Copy to .env.local for local development. Never commit real secrets.
# Deployed values live in the host's secret store and are never committed (ADR-020: Supabase for data, auth and
# storage; where the compute runs is still open).

NODE_ENV=development
LOG_LEVEL=info

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3100

# Database (docker compose). One URL per role; none is a superuser, so RLS is enforced.
# Migrations only: owns tables and policies.
MIGRATOR_DATABASE_URL=postgres://mp_migrator:mp_local_migrator@localhost:5432/moneypilot
# apps/api (RLS via app.user_id)
DATABASE_URL=postgres://mp_api:mp_local_api@localhost:5432/moneypilot
# apps/worker (RLS via app.household_id)
WORKER_DATABASE_URL=postgres://mp_worker:mp_local_worker@localhost:5432/moneypilot
# apps/worker: pg-boss keeps its queue tables in its own `pgboss` schema and creates it on first start, which
# mp_worker cannot. In any deployed environment (Supabase, ADR-020) it is required and connects as the `mp_queue`
# role (WP-09, Q-105); the schema comes from a migration and pg-boss runs with migrate: false. `pnpm dev:live`
# requires it too. Only a bare `pnpm --filter @mp/worker start` outside production falls back to the migrator URL.
# Local value for the mp_queue role from docker/postgres/init.sql:
PGBOSS_DATABASE_URL=postgres://mp_queue:mp_local_queue@localhost:5432/moneypilot

# Supabase (ADR-020, docs/runbooks/supabase-setup.md). To use a Supabase project instead of docker compose, replace
# the four URLs above with the ones `pnpm db:bootstrap:supabase` prints. They go through the SESSION pooler (port
# 5432, never 6543), carry a role-qualified user (mp_api.<project-ref>) and end in ?sslmode=require. Example shape:
#   DATABASE_URL=postgresql://mp_api.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Connections to *.supabase.com / *.supabase.co are always TLS and VERIFIED against the Supabase root CA committed in
# packages/db/certs; `sslmode` in the URL does not weaken that. Other remote hosts need `sslmode=verify-full`.
# In production an unverified remote database stops the api and worker at startup.
# Debugging only: encrypt WITHOUT verifying (logs a warning at startup, refused in production):
# MP_DB_TLS_INSECURE=1
# SUPABASE_ADMIN_URL: the `postgres` user, used ONLY by `pnpm db:bootstrap:supabase`. Remove it afterwards.
# SUPABASE_ADMIN_URL=

# Object storage for CSV uploads: MinIO locally (`pnpm storage:init` creates the bucket), Supabase Storage's S3 endpoint
# for the real-data phase. Read by apps/api (presign, head) and apps/worker (get, delete). Path-style addressing.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=mp_local
S3_SECRET_ACCESS_KEY=mp_local_only
S3_BUCKET_IMPORTS=imports
S3_REGION=us-east-1
# Uploads nobody processed, and objects with no import row, are deleted by the worker after this many hours.
# IMPORTS_ORPHAN_HOURS=24
# Supabase: S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3 and the region from Storage -> S3 Connection.
# Only when the browser reaches the store at another address than the API does (for example MinIO in a container):
# S3_PUBLIC_ENDPOINT=

# Email (Mailpit locally, SES when deployed) - read by apps/api (invite emails) and apps/worker (notifications).
# EMAIL_TRANSPORT: `smtp` (Mailpit, development only) or `ses`. Production must set it to `ses`.
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
# Sender on the dedicated mail subdomain (verified SES identity with SPF, DKIM and DMARC). Required for `ses`.
# EMAIL_FROM="MoneyPilot <notifications@mail.example.com>"
# SES configuration set that routes Delivery, Bounce and Complaint events to SNS.
# SES_CONFIGURATION_SET=
# SNS topic ARNs (comma separated) the /webhooks/ses-events endpoint accepts. Empty = it accepts nothing.
# SES_EVENTS_TOPIC_ARNS=
# AWS_REGION=us-east-1

# Auth (Supabase Auth through our API, ADR-020, WP-33). Server-side only: web and mobile never see these keys.
# The API refuses to start in production without SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, SUPABASE_SECRET_KEY,
# AUTH_COOKIE_SECRET, WEB_ORIGIN and API_PUBLIC_URL (all https). Tests use a fake Supabase and need none of these.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Signs the Google sign-in state cookie. 32+ random bytes, base64 (openssl rand -base64 32). Not the Supabase key.
AUTH_COOKIE_SECRET=
# Where the browser reaches this API (Google's return trip lands on <it>/v1/auth/google/callback; add that URL to
# Supabase's Redirect URLs). Required in production.
API_PUBLIC_URL=http://localhost:4000

# AI (Anthropic, added in WP-11). Dev/staging key only.
ANTHROPIC_API_KEY=

# Web (apps/web). `pnpm dev` runs the app in MOCK MODE: MSW answers the API from the golden fixture and
# a fake session is signed in, so no backend is needed. Mock mode only exists on the dev server; the
# build refuses it. `pnpm dev:live` runs api, worker and web against .env.local WITHOUT mock mode (do not set
# NEXT_PUBLIC_MP_MOCK there); sign-in goes through the API's /v1/auth routes (Supabase Auth, ADR-020).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Origin the browser uploads CSVs to (same host as S3_ENDPOINT / S3_PUBLIC_ENDPOINT). Added to the CSP connect-src.
# In development it defaults to local MinIO, http://localhost:9000.
NEXT_PUBLIC_STORAGE_URL=http://localhost:9000
# Set to 1 to show "Continue with Google" (Google must be enabled in Supabase, see docs/runbooks/supabase-setup.md).
NEXT_PUBLIC_GOOGLE_SIGN_IN=

# Billing (WP-25). No real provider is chosen yet (H-01). `fake` is for local development only and is refused in
# production. Use a throwaway local secret, never a real one.
BILLING_PROVIDER=
BILLING_WEBHOOK_SECRET=

# ---- Email connections (WP-21). Off until a provider is configured; no real inbox before gate G2. ----
# A provider needs all of its settings: a partial set stops apps/api and apps/worker at startup.
# API_PUBLIC_URL (set above) is also the base of the email OAuth redirect URI,
# {API_PUBLIC_URL}/v1/email-connections/{gmail|outlook}/callback, and of Graph notifications ({API_PUBLIC_URL}/webhooks/graph).
# Gmail (scope gmail.readonly, offline access). Google Cloud OAuth client; keep the project in Testing mode for now.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
# Gmail push through Pub/Sub needs a public endpoint. Leave all three empty locally: the worker polls instead.
GMAIL_PUBSUB_TOPIC=
GMAIL_PUSH_AUDIENCE=
GMAIL_PUSH_SERVICE_ACCOUNT=
# Outlook / Microsoft 365 (Mail.Read, offline_access).
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Secrets: base64 of at least 32 random bytes, the same in apps/api and apps/worker. Generate each with:
#   openssl rand -base64 32
# EMAIL_ADDRESS_HASH_KEY matches a Gmail push to its mailbox; EMAIL_WEBHOOK_SECRET signs the Graph clientState.
EMAIL_ADDRESS_HASH_KEY=
EMAIL_WEBHOOK_SECRET=
# How often each mailbox is checked when no push arrives (1 to 1440 minutes). Default 15.
EMAIL_POLL_MINUTES=
# Token encryption (packages/crypto). Local dev only, refused outside development/test: TOKEN_MASTER_KEY, base64 of
# exactly 32 random bytes (`openssl rand -base64 32`), a throwaway value. Anywhere else: KMS_TOKEN_KEY_ID (key id,
# ARN or alias), and TOKEN_MASTER_KEY must be unset.
TOKEN_MASTER_KEY=
# Rotate with KMS automatic key rotation (same key id), not by switching ids: the worker only decrypts with this id.
KMS_TOKEN_KEY_ID=
