# Copy to .env.local for local development. Never commit real secrets.
# Production values live in AWS Secrets Manager (BACKEND_PLAN §4).

NODE_ENV=development
LOG_LEVEL=info

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3100

# Database (docker compose). One URL per role; none is a superuser, so RLS is enforced.
# Migrations only: owns tables and policies.
MIGRATOR_DATABASE_URL=postgres://mp_migrator:mp_local_migrator@localhost:5432/moneypilot
# apps/api (RLS via app.user_id)
DATABASE_URL=postgres://mp_api:mp_local_api@localhost:5432/moneypilot
# apps/worker (RLS via app.household_id)
WORKER_DATABASE_URL=postgres://mp_worker:mp_local_worker@localhost:5432/moneypilot
# apps/worker: pg-boss keeps its queue tables in its own `pgboss` schema and creates it on first start, which
# mp_worker cannot. Falls back to MIGRATOR_DATABASE_URL locally; AWS needs a dedicated role (Q-105).
# PGBOSS_DATABASE_URL=

# Object storage (MinIO locally, S3 in AWS)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=mp_local
S3_SECRET_ACCESS_KEY=mp_local_only

# Email (Mailpit locally, SES in AWS) - read by apps/api (invite emails) and apps/worker (notifications).
# EMAIL_TRANSPORT: `smtp` (Mailpit, development only) or `ses`. Production must set it to `ses`.
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
# Sender on the dedicated mail subdomain (verified SES identity with SPF, DKIM and DMARC). Required for `ses`.
# EMAIL_FROM="MoneyPilot <notifications@mail.example.com>"
# SES configuration set that routes Delivery, Bounce and Complaint events to SNS.
# SES_CONFIGURATION_SET=
# SNS topic ARNs (comma separated) the /webhooks/ses-events endpoint accepts. Empty = it accepts nothing.
# SES_EVENTS_TOPIC_ARNS=
# AWS_REGION=us-east-1

# Auth (AWS Cognito user pool, ADR-017; tests use a fake issuer and need none of these)
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# AI (Anthropic, added in WP-11). Dev/staging key only.
ANTHROPIC_API_KEY=

# Web (apps/web). `pnpm dev` runs the app in MOCK MODE: MSW answers the API from the golden fixture and
# a fake session is signed in, so no AWS is needed. Mock mode only exists on the dev server; the
# build refuses it. Set these (and run `pnpm --filter @mp/web dev:cognito`) to sign in for real.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
# Optional: the hosted UI domain, only for "Continue with Google".
NEXT_PUBLIC_COGNITO_OAUTH_DOMAIN=

# Billing (WP-25). No real provider is chosen yet (H-01). `fake` is for local development only and is refused in
# production. Use a throwaway local secret, never a real one.
BILLING_PROVIDER=
BILLING_WEBHOOK_SECRET=

# ---- Email connections (WP-21). Off until a provider is configured; no real inbox before gate G2. ----
# A provider needs all of its settings: a partial set stops apps/api and apps/worker at startup.
# Public origin of the API. The OAuth redirect URI is {API_PUBLIC_URL}/v1/email-connections/{gmail|outlook}/callback
# and Graph notifications go to {API_PUBLIC_URL}/webhooks/graph.
API_PUBLIC_URL=
# Gmail (scope gmail.readonly, offline access). Google Cloud OAuth client; keep the project in Testing mode for now.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
# Gmail push through Pub/Sub needs a public endpoint. Leave all three empty locally: the worker polls instead.
GMAIL_PUBSUB_TOPIC=
GMAIL_PUSH_AUDIENCE=
GMAIL_PUSH_SERVICE_ACCOUNT=
# Outlook / Microsoft 365 (Mail.Read, offline_access).
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Secrets: base64 of at least 32 random bytes, the same in apps/api and apps/worker. Generate each with:
#   openssl rand -base64 32
# EMAIL_ADDRESS_HASH_KEY matches a Gmail push to its mailbox; EMAIL_WEBHOOK_SECRET signs the Graph clientState.
EMAIL_ADDRESS_HASH_KEY=
EMAIL_WEBHOOK_SECRET=
# How often each mailbox is checked when no push arrives (1 to 1440 minutes). Default 15.
EMAIL_POLL_MINUTES=
# Token encryption (packages/crypto). Local dev only, refused outside development/test: TOKEN_MASTER_KEY, base64 of
# exactly 32 random bytes (`openssl rand -base64 32`), a throwaway value. Anywhere else: KMS_TOKEN_KEY_ID (key id,
# ARN or alias), and TOKEN_MASTER_KEY must be unset.
TOKEN_MASTER_KEY=
# Rotate with KMS automatic key rotation (same key id), not by switching ids: the worker only decrypts with this id.
KMS_TOKEN_KEY_ID=
