# Copy to .env.local for local development. Never commit real secrets.
# Production values live in AWS Secrets Manager (BACKEND_PLAN §4).

NODE_ENV=development
LOG_LEVEL=info

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3100

# Database (docker compose). One URL per role; none is a superuser, so RLS is enforced.
# Migrations only: owns tables and policies.
MIGRATOR_DATABASE_URL=postgres://mp_migrator:mp_local_migrator@localhost:5432/moneypilot
# apps/api (RLS via app.user_id)
DATABASE_URL=postgres://mp_api:mp_local_api@localhost:5432/moneypilot
# apps/worker (RLS via app.household_id)
WORKER_DATABASE_URL=postgres://mp_worker:mp_local_worker@localhost:5432/moneypilot

# Object storage (MinIO locally, S3 in AWS)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=mp_local
S3_SECRET_ACCESS_KEY=mp_local_only

# Email (Mailpit locally, SES in AWS)
SMTP_HOST=localhost
SMTP_PORT=1025

# Auth (Clerk dev instance, added in WP-05)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# AI (Anthropic, added in WP-11). Dev/staging key only.
ANTHROPIC_API_KEY=
