{
  "$description": "MoneyPilot AI design tokens v1.1, Harbor palette (MVP, light theme). Source of truth for web (tokens.css) and React Native. Keep in sync with docs/DESIGN_SPEC.md and the design canvas.",
  "color": {
    "bg": {
      "canvas": { "$value": "#F2F4F7", "$type": "color", "$description": "App background" },
      "surface": { "$value": "#FFFFFF", "$type": "color", "$description": "Cards, sidebar, tab bar, bottom bars" },
      "subtle": { "$value": "#F6F8FA", "$type": "color", "$description": "Math boxes, extracted-field boxes, mobile inputs" },
      "muted": { "$value": "#F9FAFB", "$type": "color", "$description": "Out-of-month calendar cells" },
      "track": { "$value": "#E5EAF0", "$type": "color", "$description": "Progress tracks, skeletons, disabled button fill, segmented track on canvas" }
    },
    "border": {
      "default": { "$value": "#DFE4EB", "$type": "color", "$description": "Card, bar and sidebar borders" },
      "divider": { "$value": "#EDF0F4", "$type": "color", "$description": "Row dividers inside cards" },
      "strong": { "$value": "#C9D1DC", "$type": "color", "$description": "Inputs, secondary buttons, pills, empty-state dashes" },
      "cell": { "$value": "#E6EAF0", "$type": "color", "$description": "Calendar cell border" }
    },
    "text": {
      "primary": { "$value": "#111C2B", "$type": "color" },
      "secondary": { "$value": "#334155", "$type": "color" },
      "muted": { "$value": "#566173", "$type": "color" },
      "disabled": { "$value": "#636E7E", "$type": "color" },
      "inverse": { "$value": "#FFFFFF", "$type": "color" }
    },
    "brand": {
      "default": { "$value": "#1F4E79", "$type": "color", "$description": "Primary actions, active nav, focus ring" },
      "strong": { "$value": "#132F4C", "$type": "color", "$description": "Hero card, primary hover" },
      "soft": { "$value": "#E3ECF5", "$type": "color", "$description": "Active nav bg, ok chips" },
      "onSoft": { "$value": "#1A3F63", "$type": "color", "$description": "Text on brand.soft" },
      "tint": { "$value": "#F3F7FB", "$type": "color", "$description": "Selected rows, selected radio cards, payday cells" },
      "onStrongMuted": { "$value": "#C9D8E8", "$type": "color", "$description": "Labels on hero card" },
      "onStrongSubtle": { "$value": "#DCE6F2", "$type": "color", "$description": "Secondary text on hero card" },
      "strongDivider": { "$value": "#2A4A6E", "$type": "color", "$description": "Divider inside hero card" },
      "paydayBorder": { "$value": "#B9CCE0", "$type": "color", "$description": "Payday legend swatch border" }
    },
    "attention": {
      "text": { "$value": "#8F430C", "$type": "color", "$description": "Needs-a-decision text and icons. Use for nothing else." },
      "soft": { "$value": "#FBEEE2", "$type": "color" },
      "surface": { "$value": "#FFF8F1", "$type": "color" },
      "border": { "$value": "#F0D9C4", "$type": "color" },
      "chipBorder": { "$value": "#E6BE98", "$type": "color" },
      "mark": { "$value": "#C2691F", "$type": "color", "$description": "Graphics only: lowest bar, alert dot, radar dot" },
      "markOnStrong": { "$value": "#F0A868", "$type": "color", "$description": "Lowest bar on hero card" }
    },
    "info": {
      "text": { "$value": "#3E4C5E", "$type": "color" },
      "soft": { "$value": "#E8ECF1", "$type": "color" },
      "border": { "$value": "#7D8A9C", "$type": "color", "$description": "Dashed border for estimates" }
    },
    "income": {
      "text": { "$value": "#18794E", "$type": "color", "$description": "Income amounts (+$) and income KPI values" },
      "soft": { "$value": "#E3F3EA", "$type": "color", "$description": "Income chip background" },
      "onSoft": { "$value": "#146B44", "$type": "color", "$description": "Text on income.soft" },
      "border": { "$value": "#A6D8BE", "$type": "color", "$description": "Income chip border in calendar" }
    },
    "partnerA": {
      "mark": { "$value": "#0F7B6C", "$type": "color", "$description": "Household creator (teal): dots, bars" },
      "soft": { "$value": "#DDF1EE", "$type": "color", "$description": "Avatar background" },
      "text": { "$value": "#0B5A4F", "$type": "color", "$description": "Avatar initial" }
    },
    "partnerB": {
      "mark": { "$value": "#8A4FB0", "$type": "color", "$description": "Invited partner (plum): dots, bars" },
      "soft": { "$value": "#F0E6F6", "$type": "color" },
      "text": { "$value": "#5E2F80", "$type": "color" }
    },
    "both": {
      "mark": { "$value": "#1F4E79", "$type": "color", "$description": "Items owned by both partners" }
    },
    "chart": {
      "balance": { "$value": "#5F86AE", "$type": "color" },
      "payday": { "$value": "#1F4E79", "$type": "color" },
      "lowest": { "$value": "#C2691F", "$type": "color" },
      "cushion": { "$value": "#C98A57", "$type": "color" },
      "axis": { "$value": "#D3DAE3", "$type": "color" },
      "barOnStrong": { "$value": "#4C6E94", "$type": "color" },
      "paydayOnStrong": { "$value": "#C9D8E8", "$type": "color" }
    },
    "control": {
      "off": { "$value": "#B7C0CC", "$type": "color", "$description": "Switch track when off" },
      "radioOff": { "$value": "#8794A6", "$type": "color", "$description": "Radio ring when unselected" }
    }
  },
  "font": {
    "family": {
      "display": { "$value": ["Manrope", "Inter", "system-ui", "sans-serif"], "$type": "fontFamily", "$description": "Headings and money amounts. Weights 600/700/800." },
      "body": { "$value": ["Inter", "system-ui", "sans-serif"], "$type": "fontFamily", "$description": "All other text. Weights 400/500/600." }
    }
  },
  "typography": {
    "display-xl": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": 800, "fontSize": "52px", "lineHeight": "52px", "letterSpacing": "-0.03em" }, "$description": "Web hero amount" },
    "display-l": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": 800, "fontSize": "44px", "lineHeight": "44px", "letterSpacing": "-0.03em" }, "$description": "Mobile hero amount" },
    "amount-xl": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": 800, "fontSize": "34px", "lineHeight": "38px", "letterSpacing": "-0.02em" }, "$description": "Mobile detail amount, mobile renewals total" },
    "heading-1": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": 800, "fontSize": "32px", "lineHeight": "37px", "letterSpacing": "-0.02em" }, "$description": "Web page title" },
    "amount-l": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": 800, "fontSize": "28px", "lineHeight": "34px", "letterSpacing": "-0.02em" }, "$description": "KPI tiles, detail panel amount" },
    "heading-1m": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": 800, "fontSize": "26px", "lineHeight": "30px", "letterSpacing": "-0.02em" }, "$description": "Mobile screen title" },
    "heading-3": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": 800, "fontSize": "22px", "lineHeight": "28px", "letterSpacing": "0" }, "$description": "Detail panel title, selected day" },
    "heading-2": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": 700, "fontSize": "18px", "lineHeight": "24px", "letterSpacing": "0" }, "$description": "Card titles (web)" },
    "heading-2m": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": 700, "fontSize": "16px", "lineHeight": "22px", "letterSpacing": "0" }, "$description": "Card titles (mobile)" },
    "title": { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontWeight": 600, "fontSize": "15px", "lineHeight": "21px", "letterSpacing": "0" }, "$description": "Item titles, card headlines" },
    "body-l": { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontWeight": 400, "fontSize": "15px", "lineHeight": "22px", "letterSpacing": "0" }, "$description": "Page subtitles" },
    "body": { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontWeight": 400, "fontSize": "14px", "lineHeight": "20px", "letterSpacing": "0" }, "$description": "Default UI text; 500/600 for emphasis" },
    "small": { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontWeight": 400, "fontSize": "13px", "lineHeight": "19px", "letterSpacing": "0" }, "$description": "Card body, explanations" },
    "caption": { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontWeight": 400, "fontSize": "12px", "lineHeight": "17px", "letterSpacing": "0" }, "$description": "Meta, chips (600)" },
    "overline": { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontWeight": 600, "fontSize": "12px", "lineHeight": "16px", "letterSpacing": "0.08em" }, "$description": "Uppercase eyebrows. Table headers use 11px / +0.06em." },
    "micro": { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontWeight": 400, "fontSize": "11px", "lineHeight": "14px", "letterSpacing": "0" }, "$description": "Tab labels, chart labels, calendar chips" }
  },
  "space": {
    "0_5": { "$value": "2px", "$type": "dimension" },
    "1": { "$value": "4px", "$type": "dimension" },
    "1_5": { "$value": "6px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "2_5": { "$value": "10px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "3_5": { "$value": "14px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "5": { "$value": "20px", "$type": "dimension" },
    "5_5": { "$value": "22px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "7": { "$value": "28px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" },
    "14": { "$value": "56px", "$type": "dimension" }
  },
  "radius": {
    "xs": { "$value": "6px", "$type": "dimension" },
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "10px", "$type": "dimension" },
    "lg": { "$value": "12px", "$type": "dimension" },
    "xl": { "$value": "14px", "$type": "dimension" },
    "2xl": { "$value": "16px", "$type": "dimension" },
    "3xl": { "$value": "18px", "$type": "dimension" },
    "4xl": { "$value": "20px", "$type": "dimension" },
    "full": { "$value": "999px", "$type": "dimension" }
  },
  "shadow": {
    "selected": { "$value": "0 1px 2px rgba(17,28,43,0.12)", "$type": "shadow", "$description": "Selected segment only" },
    "overlay": { "$value": "0 8px 24px rgba(17,28,43,0.16)", "$type": "shadow", "$description": "Menus, dialogs, toasts" }
  },
  "size": {
    "touchTarget": { "$value": "44px", "$type": "dimension" },
    "sidebarWidth": { "$value": "240px", "$type": "dimension" },
    "contentMaxWidth": { "$value": "1160px", "$type": "dimension" },
    "mobileGutter": { "$value": "16px", "$type": "dimension" },
    "buttonHeightWeb": { "$value": "40px", "$type": "dimension" },
    "buttonHeightMobile": { "$value": "46px", "$type": "dimension" },
    "buttonHeightMobileBar": { "$value": "50px", "$type": "dimension" },
    "inputHeight": { "$value": "44px", "$type": "dimension" },
    "segmentHeight": { "$value": "36px", "$type": "dimension" },
    "iconNav": { "$value": "18px", "$type": "dimension" },
    "iconTab": { "$value": "22px", "$type": "dimension" },
    "iconInline": { "$value": "16px", "$type": "dimension" },
    "iconStroke": { "$value": 1.8, "$type": "number" },
    "focusRing": { "$value": "2px", "$type": "dimension" },
    "focusOffset": { "$value": "2px", "$type": "dimension" }
  },
  "tracking": {
    "tableHeader": { "$value": "0.06em", "$type": "dimension", "$description": "Letter spacing for 11px uppercase table headers" }
  },
  "breakpoint": {
    "compact": { "$value": "800px", "$type": "dimension", "$description": "Below: top bar + drawer instead of sidebar" },
    "wide": { "$value": "1200px", "$type": "dimension", "$description": "At or above: two-column body" }
  },
  "motion": {
    "duration": { "$value": "150ms", "$type": "duration" },
    "easing": { "$value": [0, 0, 0.2, 1], "$type": "cubicBezier", "$description": "ease-out; animate opacity and color only; disable with prefers-reduced-motion" }
  }
}
